# 로컬 Next.js와 Cloudflare Pages Function이 FastAPI 서버로 요청을 전달할 주소
# Cloudflare에서는 이 파일을 올리지 말고 Pages의 Variables and Secrets에 같은 이름으로 등록합니다.
BACKEND_API_URL=http://127.0.0.1:8000

# 백엔드 실행 시 사용할 주소와 포트
HOST=127.0.0.1
PORT=8000

# 기본 저장소는 PostgreSQL입니다. scripts/setup-db.py가 로컬 .env를 생성합니다.
# 아래 주소에는 비밀번호가 없습니다. 예시 파일로 실제 .env를 덮어쓰지 마세요.
DATABASE_URL=postgresql+psycopg://scm@127.0.0.1:5433/scm_demo
# 기존 SQLite 파일은 보존합니다. 필요 시 명시적으로 지정하여 조회할 수 있습니다.
# DATABASE_URL=sqlite:///./scm_demo.db

# 화면과 API 통신을 허용할 개발 주소
FRONTEND_ORIGIN=http://localhost:3000
# 선택 기능: 미해결 컬럼 헤더와 최소 표준 식별정보로 AI 매칭 추천을 사용할 때 설정합니다.
# 키는 화면이나 코드에 입력하지 말고 로컬 .env에만 보관하세요.
OPENAI_API_KEY=
OPENAI_MAPPING_MODEL=gpt-5-mini
OPENAI_MATCHING_MODEL=gpt-5-mini
OPENAI_UNSTRUCTURED_MODEL=gpt-5-mini
# 메일·붙여넣기 본문에서 OpenAI로 보낼 최대 글자 수입니다. 원본은 잘리지 않고 DB에 보존됩니다.
OPENAI_UNSTRUCTURED_MAX_CHARS=60000
# 한 파일에서 AI 주문 후보 추천을 요청할 최대 행 수입니다. 나머지는 규칙 기반 검토로 남깁니다.
OPENAI_MATCH_MAX_ROWS=20
